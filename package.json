{
  "name": "mini-apps",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev:hud": "pnpm --filter @mini-apps/hud-pwa dev",
    "preview:hud": "pnpm --filter @mini-apps/hud-pwa preview",
    "dev:golf": "pnpm --filter @mini-apps/golf-pwa dev",
    "preview:golf": "pnpm --filter @mini-apps/golf-pwa preview",
    "dev:metronome": "pnpm --filter @mini-apps/workout-metronome-pwa dev",
    "preview:metronome": "pnpm --filter @mini-apps/workout-metronome-pwa preview",
    "dev:metronome:toss": "pnpm --filter @mini-apps/workout-metronome-toss dev",
    "preview:metronome:toss": "pnpm --filter @mini-apps/workout-metronome-toss preview",
    "build:metronome:toss": "pnpm --filter @mini-apps/workout-metronome-toss build",
    "build:ait:metronome": "pnpm --filter @mini-apps/workout-metronome-toss build:ait",
    "build:ait:metronome:test": "pnpm --filter @mini-apps/workout-metronome-toss build:ait:test",
    "build:ait:metronome:live": "pnpm --filter @mini-apps/workout-metronome-toss build:ait:live",
    "dev:cloudflare:hud": "pnpm --filter @mini-apps/hud-pwa dev:cloudflare",
    "deploy:cloudflare:hud": "pnpm --filter @mini-apps/hud-pwa deploy:cloudflare",
    "dev:cloudflare:golf": "pnpm --filter @mini-apps/golf-pwa dev:cloudflare",
    "deploy:cloudflare:golf": "pnpm --filter @mini-apps/golf-pwa deploy:cloudflare",
    "dev:cloudflare:metronome": "pnpm --filter @mini-apps/workout-metronome-pwa dev:cloudflare",
    "deploy:cloudflare:metronome": "pnpm --filter @mini-apps/workout-metronome-pwa deploy:cloudflare",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  }
}
