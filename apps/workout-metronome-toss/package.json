{
  "name": "@mini-apps/workout-metronome-toss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4182 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:ait": "pnpm run build && ait build",
    "build:ait:test": "tsc --noEmit && vite build --mode ad-test && ait build",
    "build:ait:live": "tsc --noEmit && vite build --mode ad-live && ait build"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.9.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "2.5.1",
    "@toss/tds-mobile-ait": "2.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
